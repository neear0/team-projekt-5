{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string"
    },
    "criteria": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "points": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "description": {
            "type": "string"
          },
          "rules": {
            "default": [],
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "html.valid"
                    },
                    "max_errors": {
                      "default": 0,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "HTML prejde validátorom."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "html.label_for_inputs"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "Každý vstup formulára má <label>."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "html.uses_tags"
                    },
                    "tags": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      }
                    }
                  },
                  "required": [
                    "type",
                    "tags"
                  ],
                  "additionalProperties": false,
                  "description": "Stránka používa všetky uvedené elementy."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "html.img_alt"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "Každý <img> má atribút alt."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "css.uses_layout"
                    },
                    "any_of": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "flex",
                          "grid"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "any_of"
                  ],
                  "additionalProperties": false,
                  "description": "Layout používa Flexbox alebo Grid."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "css.media_queries"
                    },
                    "min": {
                      "default": 1,
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "CSS obsahuje aspoň `min` media queries."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "css.custom_properties"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "CSS definuje a používa vlastné premenné (--farba …)."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "css.no_inline_styles"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "HTML nemá atribúty style."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "js.no_inline_handlers"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "Udalosti cez addEventListener, nie onclick v HTML."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "js.no_var"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "Premenné cez let a const, nie var."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "js.no_errors"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "ESLint nenájde chyby."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "axe.max_violations"
                    },
                    "min_impact": {
                      "default": "serious",
                      "type": "string",
                      "enum": [
                        "minor",
                        "moderate",
                        "serious",
                        "critical"
                      ]
                    },
                    "max": {
                      "default": 0,
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "axe-core nenájde porušenia prístupnosti."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "lighthouse.min_score"
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "performance",
                        "accessibility",
                        "best_practices",
                        "seo"
                      ]
                    },
                    "min": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    }
                  },
                  "required": [
                    "type",
                    "category",
                    "min"
                  ],
                  "additionalProperties": false,
                  "description": "Lighthouse skóre v kategórii je aspoň `min`."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "runtime.no_console_errors"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "description": "Konzola prehliadača je bez chýb."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "file.exists"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type",
                    "path"
                  ],
                  "additionalProperties": false,
                  "description": "V repozitári je uvedený súbor."
                }
              ]
            }
          },
          "ai": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "points"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "id",
    "title",
    "criteria"
  ],
  "additionalProperties": false
}
