{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/runtime.ts": { "maxDuration": 300 },
    "api/probe.ts": {
      "maxDuration": 300,
      "includeFiles": "../../node_modules/.pnpm/{@sparticuz+chromium@*/*/*/chromium/bin,lighthouse@*/*/lighthouse/{core,dist/report,*/assets,shared,third-party},node_modules/{ajv*,axe-core,csp_evaluator,http-link-*,image-ssim,jpeg-js,js-library-*,robots-*,speedline-core}}/**"
    }
  }
}
